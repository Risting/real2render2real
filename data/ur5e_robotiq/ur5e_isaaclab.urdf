<robot name="ur5e">
  <!--
    UR5e URDF for JaxMP IK - kinematic parameters from Isaac Sim official URDF.
    Matches the USD model used in Isaac Lab simulation.
    Mesh files not included - this URDF is for kinematic calculations only.
  -->

  <!-- Base -->
  <link name="base_link"/>

  <link name="base_link_inertia">
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.004433" ixy="0" ixz="0" iyy="0.004433" iyz="0" izz="0.0072"/>
    </inertial>
  </link>
  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>

  <!-- Shoulder -->
  <link name="shoulder_link">
    <inertial>
      <mass value="3.7"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.010267" ixy="0" ixz="0" iyy="0.010267" iyz="0" izz="0.00666"/>
    </inertial>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1625"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="150.0" velocity="3.14"/>
  </joint>

  <!-- Upper arm -->
  <link name="upper_arm_link">
    <inertial>
      <mass value="8.393"/>
      <origin xyz="-0.2125 0 0.138" rpy="0 1.5707963 0"/>
      <inertia ixx="0.133886" ixy="0" ixz="0" iyy="0.133886" iyz="0" izz="0.015107"/>
    </inertial>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="150.0" velocity="3.14"/>
  </joint>

  <!-- Forearm -->
  <link name="forearm_link">
    <inertial>
      <mass value="2.275"/>
      <origin xyz="-0.1961 0 0.007" rpy="0 1.5707963 0"/>
      <inertia ixx="0.031209" ixy="0" ixz="0" iyy="0.031209" iyz="0" izz="0.004095"/>
    </inertial>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.425 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415927" upper="3.1415927" effort="150.0" velocity="3.14"/>
  </joint>

  <!-- Wrist 1 -->
  <link name="wrist_1_link">
    <inertial>
      <mass value="1.219"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002560" ixy="0" ixz="0" iyy="0.002560" iyz="0" izz="0.002194"/>
    </inertial>
  </link>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.3922 0 0.1333"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="28.0" velocity="3.14"/>
  </joint>

  <!-- Wrist 2 -->
  <link name="wrist_2_link">
    <inertial>
      <mass value="1.219"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002560" ixy="0" ixz="0" iyy="0.002560" iyz="0" izz="0.002194"/>
    </inertial>
  </link>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.0997 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="28.0" velocity="3.14"/>
  </joint>

  <!-- Wrist 3 -->
  <link name="wrist_3_link">
    <inertial>
      <mass value="0.1879"/>
      <origin xyz="0 0 -0.0229" rpy="0 0 0"/>
      <inertia ixx="0.000099" ixy="0" ixz="0" iyy="0.000099" iyz="0" izz="0.000132"/>
    </inertial>
  </link>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin rpy="1.5707963 3.1415927 3.1415927" xyz="0 0.0996 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2831853" upper="6.2831853" effort="28.0" velocity="3.14"/>
  </joint>

  <!-- Flange -->
  <link name="flange"/>
  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin rpy="0 -1.5707963 -1.5707963" xyz="0 0 0"/>
  </joint>

  <!-- Tool0 (EE TCP) -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="flange"/>
    <child link="tool0"/>
    <origin rpy="1.5707963 0 1.5707963" xyz="0 0 0"/>
  </joint>

</robot>
